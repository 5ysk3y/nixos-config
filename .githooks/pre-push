#!/usr/bin/env bash
set -euo pipefail

# pre-push receives "<local ref> <local oid> <remote ref> <remote oid>" per
# pushed ref on stdin, and the remote name as $1. Scan exactly the commits
# being pushed — `--staged` here would only see the (usually empty) index.
remote="$1"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

echo "Running gitleaks (native) on pushed commits …"
while read -r _local_ref local_oid _remote_ref remote_oid; do
  # Branch deletion — nothing to scan
  [ "$local_oid" = "$zero" ] && continue

  if [ "$remote_oid" != "$zero" ] && git cat-file -e "${remote_oid}^{commit}" 2>/dev/null; then
    range="${remote_oid}..${local_oid}"
  else
    # New branch, or a remote tip we don't have locally (e.g. force push
    # over unfetched commits): scan everything not already on the remote.
    range="${local_oid} --not --remotes=${remote}"
  fi

  # </dev/null: keep nix/gitleaks from consuming the hook's ref list on stdin
  nix run nixpkgs#gitleaks -- git --redact --config .github/gitleaks.toml \
    --log-opts="${range}" </dev/null
done

echo "Running flake shape check …"
nix flake show --no-write-lock-file >/dev/null

# Detect platform
os="$(uname -s)"

# Evaluate the full system derivation, not just pkgs — this is what catches
# module/option errors before CI does.
case "$os" in
  Linux)
    echo "Running eval check for nixosConfigurations.gibson (linux) …"
    nix eval --raw .#nixosConfigurations.gibson.config.system.build.toplevel.drvPath \
      --no-write-lock-file >/dev/null
    ;;
  Darwin)
    echo "Running eval check for darwinConfigurations.macbook (darwin) …"
    nix eval --raw .#darwinConfigurations.macbook.config.system.build.toplevel.drvPath \
      --no-write-lock-file >/dev/null
    ;;
  *)
    echo "Unknown OS '$os', skipping platform specific eval checks"
    ;;
esac

echo "All local checks passed, proceeding with push"
