#!/usr/bin/env bash
set -euo pipefail

staged_nix_files=()
while IFS= read -r -d '' f; do
  case "$f" in
    *.nix) staged_nix_files+=("$f") ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if (( ${#staged_nix_files[@]} > 0 )); then
  echo "Formatting staged Nix files"
  for f in "${staged_nix_files[@]}"; do
    staged_tmp=$(mktemp /tmp/nixfmt-staged.XXXXXX.nix)
    original_tmp=$(mktemp /tmp/nixfmt-original.XXXXXX.nix)
    workdir_tmp=$(mktemp /tmp/nixfmt-workdir.XXXXXX.nix)
    git show ":${f}" > "$staged_tmp"
    cp "$staged_tmp" "$original_tmp"   # snapshot pre-format staged content
    cp -- "$f" "$workdir_tmp"          # snapshot working tree
    nix run nixpkgs#nixfmt -- "$staged_tmp"
    new_blob=$(git hash-object -w "$staged_tmp")
    git update-index --cacheinfo "100644,${new_blob},${f}"
    # Working tree matched pre-format staged content → no real unstaged changes
    # → safe to sync working tree to the formatted version
    if cmp -s "$workdir_tmp" "$original_tmp"; then
      cp -- "$staged_tmp" "$f"
    fi
    rm -f "$staged_tmp" "$original_tmp" "$workdir_tmp"
  done
else
  echo "No staged Nix files to format"
fi

echo "Statix"
nix run nixpkgs#statix -- check .

# ── Overlay audit liveness check ────────────────────────────────────────────
# Every host's and the system-wide overlays/overlay-entries.nix is the single
# source of truth for both the actual override and its audit metadata — a
# temporary override with no `exempt = true` and no `meta` can't silently
# exist there (enforced by an eval-time assertion in overlay-audits.nix).
#
# The actual liveness check — does each override still evaluate against the
# current locked nixpkgs, independent of tracking status — is shared with CI
# via .githooks/lib/overlay-liveness.sh, so this logic exists in exactly one
# place rather than as two hand-copied implementations that could drift.
repo_root="$(git rev-parse --show-toplevel)"
# shellcheck source=lib/overlay-liveness.sh
source "${repo_root}/.githooks/lib/overlay-liveness.sh"

overlay_dirs_touched=()
for f in "${staged_nix_files[@]}"; do
  case "$f" in
    */overlays/*.nix)
      d="$(dirname "$f")"
      already=false
      for existing in "${overlay_dirs_touched[@]:-}"; do
        [ "$existing" = "$d" ] && { already=true; break; }
      done
      [ "$already" = false ] && overlay_dirs_touched+=("$d")
      ;;
  esac
done

overlay_errors=false

hook_liveness_callback() {
  local host_key="$1" id="$2" target_host="$3" eval_attr="$4" result="$5" detail="$6"
  case "$result" in
    fail)
      echo ""
      echo "Overlay liveness error: ${host_key} / ${id} (on ${target_host})"
      echo "  evalAttr '${eval_attr}' fails to evaluate against current locked nixpkgs:"
      echo "    ${detail}"
      echo ""
      overlay_errors=true
      ;;
    skip)
      echo "  WARNING: ${host_key} / ${id}: ${detail}"
      ;;
  esac
}

if (( ${#overlay_dirs_touched[@]} > 0 )); then
  echo "Validating flake.overlayAudits ..."
  if ! AUDIT_JSON=$(nix eval .#overlayAudits --json 2>/tmp/overlay-audits-eval-err); then
    echo ""
    echo "flake.overlayAudits eval failed — an overlay-entries.nix has invalid or missing meta fields."
    cat /tmp/overlay-audits-eval-err
    overlay_errors=true
  else
    echo "  flake.overlayAudits: valid ✓"
    echo "Checking overlay liveness (does each override still evaluate) ..."

    while IFS= read -r host_key; do
      while IFS= read -r id; do
        check_entry_liveness "$AUDIT_JSON" "$host_key" "$id" hook_liveness_callback
      done < <(echo "$AUDIT_JSON" | jq -r --arg h "$host_key" '.[$h] | keys[]')
    done < <(echo "$AUDIT_JSON" | jq -r 'keys[]')

    if [ "$overlay_errors" = false ]; then
      echo "  all audited overlays evaluate cleanly ✓"
    fi
  fi
fi

if [ "$overlay_errors" = true ]; then
  exit 1
fi
